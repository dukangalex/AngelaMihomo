<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>AngelaMihomo.LoopbackManager</RootNamespace>
    <AssemblyName>AngelaMihomoLoopbackManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>AngelaMihomo</Company>
    <Product>AngelaMihomo Loopback Manager</Product>
    <Description>Manages Windows AppContainer loopback exemptions so packaged apps can reach the local AngelaMihomo proxy port.</Description>
    <Copyright>Copyright (c) AngelaMihomo contributors</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Reference assemblies let the .NET SDK build net48 targets without a
       Windows Developer Pack; the produced exe runs on the .NET Framework 4.8
       runtime that ships with Windows 10/11, so end users need nothing extra. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
